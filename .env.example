# --- Database -----------------------------------------------------------------
# Used by docker-compose to create the local Postgres container.
POSTGRES_USER=bituinsight
POSTGRES_PASSWORD=bituinsight_secret
POSTGRES_DB=bituinsight

# Used by the backend directly. Required for a managed database (Neon, Supabase,
# RDS); docker-compose sets this for you. SSL is enabled automatically for hosts
# that need it.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Security -----------------------------------------------------------------
# Signs login tokens. Use a long random string in production.
JWT_SECRET=change-me-in-production-use-long-secret-key

# --- Integrations -------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# --- AI-written summaries (optional) ------------------------------------------
# Without any of this, each report still gets a summary computed from the data.
# Configure a model and the summary is written by that model instead, with
# recommended actions. Any provider works — the platform speaks the OpenAI
# Chat Completions format, which OpenAI, Ollama, LM Studio, vLLM, Groq, Together
# and OpenRouter all accept, plus a native Anthropic path.
#
# LLM_PROVIDER: openai | ollama | anthropic | groq | together | openrouter |
#               lmstudio | vllm | none | auto (default)
#               Any other name is treated as a generic OpenAI-compatible
#               endpoint, so a new vendor only needs LLM_BASE_URL.
# LLM_PROVIDER=groq

# API key. LLM_API_KEY works for every provider; the vendor's own variable
# (OPENAI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY, ...) is accepted too.
# Never commit a real key — set it in your host's environment settings.
# LLM_API_KEY=your-api-key-here

# Model id. Each provider has a sensible default; override it here.
#   groq      -> openai/gpt-oss-120b   (verified: honours JSON mode)
#   openai    -> gpt-4o-mini
#   ollama    -> llama3.1
#   anthropic -> claude-opus-5
# LLM_MODEL=openai/gpt-oss-120b

# Endpoint override. Only needed for a self-hosted or unlisted provider; the
# presets above already know their own URLs.
# LLM_BASE_URL=http://localhost:11434/v1

# Total budget for one narrative call, retries included. The report never waits
# longer than this — a model server that is down or slow cannot stall an upload.
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=1
# LLM_MAX_TOKENS=

# Still supported on its own: set only this and the platform auto-selects
# Anthropic, exactly as before.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Storage paths ------------------------------------------------------------
# On a serverless host these must point somewhere writable, e.g. /tmp/uploads.
# UPLOAD_DIR=./uploads
# REPORTS_DIR=./reports
# CHARTS_DIR=./charts

# --- Behaviour ----------------------------------------------------------------
# Process uploads inside the request instead of in the background. Detected
# automatically on Vercel; set it manually on any host that suspends a process
# once it has responded, otherwise uploads never finish.
# PROCESS_REPORTS_INLINE=true

# Days to keep chart images before the bytes are cleared. Report rows are kept.
# CHART_RETENTION_DAYS=90

# Emergency switch to turn off server-side chart rendering. Leave unset.
# DISABLE_CHART_RENDERING=true

# --- Connecting an AI assistant over OAuth ------------------------------------
# The hosted alternative to running the stdio MCP server locally. An assistant
# registers itself, sends the person here to sign in and approve, and receives a
# read-only token scoped to that one account — no DATABASE_URL leaves the server.
#
# The one setting that matters in production. Everything an MCP client is told
# about this server is built from it — the discovery documents, the /authorize
# URL the browser is sent to, and the audience of every token — so if it is
# wrong the connect flow dead-ends in the user's browser. Must be https (except
# localhost), with no query string or fragment.
#
# Left unset it resolves, in order, to VERCEL_PROJECT_PRODUCTION_URL (the stable
# production alias), then VERCEL_URL (correct for preview deployments), then
# http://localhost:4000.
# OAUTH_ISSUER_URL=https://bituinsight.vercel.app

# Where the consent page is served, if that is not the issuer. Only needed in
# local development, where Vite runs on :3000 and the API on :4000 — and there
# CORS_ORIGIN already answers it. Set it only for a split deployment.
# OAUTH_APP_URL=http://localhost:3000

# The MCP endpoint the token is valid for, named in the protected-resource
# metadata. Defaults to <issuer>/api/mcp; override only if the endpoint moves.
# OAUTH_RESOURCE_URL=https://bituinsight.vercel.app/api/mcp
