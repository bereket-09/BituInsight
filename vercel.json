{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/src/**", "backend/assets/**", "database/**"],
        "maxDuration": 60
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.js" },
    { "src": "/\\.well-known/(.*)", "dest": "/backend/api/index.js" },
    { "src": "/(authorize|token|register|revoke)", "dest": "/backend/api/index.js" },
    { "src": "/(.+\\.[a-zA-Z0-9]+)$", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
